# Copy to `.env` and adjust as needed. All variables must be prefixed with VITE_
# to be visible to the app.

# Base path for API requests. In dev, Vite proxies this to the Express server
# (see `API_TARGET` in vite.config.ts).
VITE_API_BASE_URL=/api

# When "false", the app calls the real API instead of the in-memory mocks.
# Mocks are ON by default, so you only need this once the backend exists.
VITE_USE_MOCKS=true
