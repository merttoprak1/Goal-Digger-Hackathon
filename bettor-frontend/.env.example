# Copy to `.env` and adjust as needed. Only VITE_ variables are exposed to the
# browser. Pilot access settings below are read by the Vite server only.

# Base path for API requests. In dev, Vite proxies this to the Express server
# (see `API_TARGET` in vite.config.ts).
VITE_API_BASE_URL=/api

# Enable this gate before exposing the Vite server through a tunnel. Set a
# unique password in .env and share it only with pilot participants.
PILOT_MODE=false
# PILOT_ACCESS_PASSWORD=
